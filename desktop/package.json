{
  "name": "dota-mid-helper",
  "productName": "Outpick",
  "license": "AGPL-3.0-only",
  "version": "0.9.1",
  "description": "Outpick: пикер для Dota 2 под твой пул, разбор матчей и история драфтов",
  "author": "KapaT",
  "main": "main.js",
  "private": true,
  "scripts": {
    "prepare-app": "node scripts/prepare-app.mjs",
    "start": "electron .",
    "build:mac": "npm run prepare-app && electron-builder --mac",
    "build:win": "npm run prepare-app && electron-builder --win"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "ru.kapat.dotamidhelper",
    "productName": "Outpick",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "recognize.js",
      "frames.js",
      "icon.png",
      "splash.html"
    ],
    "extraResources": [
      {
        "from": "next-app",
        "to": "next-app"
      },
      {
        "from": "../data",
        "to": "data",
        "filter": [
          "*.json",
          "!draft-log.json",
          "!config.json"
        ]
      },
      {
        "from": "assets",
        "to": "assets"
      }
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "Outpick-${version}-portable.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "Outpick-${version}-setup.exe",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/uninstallerSidebar.bmp",
      "installerHeader": "build/installerHeader.bmp",
      "shortcutName": "Outpick"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.games",
      "identity": null
    },
    "publish": {
      "provider": "github",
      "owner": "KapaT705",
      "repo": "dota-mid-helper",
      "releaseType": "release"
    }
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "electron-updater": "^6.8.11",
    "jpeg-js": "^0.4.4",
    "pngjs": "^7.0.0"
  }
}
